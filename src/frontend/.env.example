# Copie para frontend/.env.local e reinicie o Vite.
# Deixe vazio para usar os mocks locais. Não inclua segredos nem barra final.
VITE_API_BASE_URL=

# Opcional. Ex.: /api/copilot. O frontend chamará POST /lawyer ou POST /admin.
# Use um backend autenticado; nunca coloque OPENAI_API_KEY ou outro segredo no Vite.
VITE_COPILOT_API_URL=/api/copilot

# Destino usado apenas pelo proxy do servidor de desenvolvimento do Vite.
COPILOT_PROXY_TARGET=http://127.0.0.1:8787
